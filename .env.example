# ─────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────
TELEGRAM_TOKEN=seu_token_do_botfather
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ─────────────────────────────────────────────
# Mercado Livre
# ─────────────────────────────────────────────
ML_CLIENT_ID=seu_client_id
ML_CLIENT_SECRET=seu_client_secret
ML_REDIRECT_URI=https://seudominio.com.br/auth/callback
ML_AFFILIATE_ID=seu_id_de_afiliado
ML_REFRESH_TOKEN=seu_refresh_token

# ─────────────────────────────────────────────
# Bot
# ─────────────────────────────────────────────
CHECK_INTERVAL_MS=1800000
MIN_DISCOUNT=15
LOG_LEVEL=info
NODE_ENV=production
DB_PATH=./data/bot.sqlite

# Canais Telegram para monitorar cupons (separados por virgula)
COUPON_CHANNELS=promotop,grupo_promocoes

# ─────────────────────────────────────────────
# WhatsApp (Baileys)
# ─────────────────────────────────────────────
# JID do grupo que recebe as ofertas. Rode `npm run wa-login` para descobrir.
# Ex.: 120363XXXXXXXXXXXX@g.us  (deixe vazio para desativar o WhatsApp)
WHATSAPP_GROUP_ID=
# Pasta onde a sessão do WhatsApp fica salva (padrao: ./data/whatsapp_auth)
WHATSAPP_AUTH_DIR=./data/whatsapp_auth

# ─────────────────────────────────────────────
# Sync do SQLite com o servidor do website (opcional)
# ─────────────────────────────────────────────
# Vazio = desligado (rodando local, sem servidor do site).
# Quando tiver a VPS, preencha com o comando scp. Exemplo:
# WEBSITE_SYNC_CMD=scp -o StrictHostKeyChecking=no -i /home/ubuntu/.ssh/sync_key /home/ubuntu/Bot-Sales-channels/data/bot.sqlite ubuntu@SEU_IP:/home/ubuntu/ofertadelas-website/data/bot.sqlite
WEBSITE_SYNC_CMD=
