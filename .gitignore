# Dependências
node_modules/
package-lock.json
yarn.lock

# Variáveis de ambiente (CRÍTICO: Nunca comitar)
.env
.env.dev
.env.prod
.env.local
.env.*.local
# Backups de .env (ex.: .env.bak-20260820201839) — as regras acima NÃO os pegam,
# e sem isto um `git add -A` no servidor commitaria segredos no repo público.
.env.*
!.env.example

# Backups automáticos de edições feitas direto no servidor (*.bak-<timestamp>)
*.bak
*.bak-*

# Banco de Dados
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-shm
data/*.sqlite-wal

# Logs
logs/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE e Sistema
.vscode/
.idea/
.DS_Store
Thumbs.db

# Testes
coverage/
.nyc_output/

# PM2
pm2.log
pm2.error.log
pm2.pid

# Sessão autenticada ML (contém cookies — NUNCA comitar)
data/ml_session.json
data/

# Screenshots de debug do Playwright
logs/*.png
logs/

# Assets locais (imagens grandes — adicionar manualmente no EC2)
src/assets/

# Memory do Claude Code
memory/
